<Window x:Class="MuOnline.BuildPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MU Online Build Planner"
        Width="720"
        Height="920"
        MinWidth="640"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Grid.ColumnSpan="2"
                       Text="MU Online Build Planner" />

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,8,0,24"
                       TextWrapping="Wrap"
                       Text="Presupuesto de puntos ganados — ruleset Season 4 global/inglés verificado." />

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       Text="Clase" />
            <ComboBox x:Name="ClassComboBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      MinHeight="30"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ClassSelectionChanged" />

            <TextBlock Grid.Row="3"
                       Margin="0,12,0,0"
                       VerticalAlignment="Center"
                       Text="Evolución" />
            <ComboBox x:Name="EvolutionComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,12,0,0"
                      MinHeight="30"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="EvolutionSelectionChanged" />

            <TextBlock Grid.Row="4"
                       Margin="0,12,0,0"
                       VerticalAlignment="Center"
                       Text="Nivel" />
            <TextBox x:Name="LevelTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,12,0,0"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     TextChanged="ProgressionInputChanged"
                     Text="1" />

            <CheckBox x:Name="HeroStatusCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,16,0,0"
                      Checked="ProgressionInputChanged"
                      Unchecked="ProgressionInputChanged"
                      Content="Hero Status / Marlon completado" />

            <Button Grid.Row="6"
                    Grid.Column="1"
                    Width="160"
                    Margin="0,20,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Click="CalculateButtonClick"
                    Content="Calcular puntos" />

            <TextBox x:Name="ResultTextBox"
                     Grid.Row="7"
                     Grid.ColumnSpan="2"
                     Margin="0,24,0,0"
                     Padding="12"
                     MinHeight="160"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado y traza" />

            <GroupBox Grid.Row="8"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Configuración de resets del servidor">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Resets" />
                    <TextBox x:Name="ResetCountTextBox"
                             Grid.Column="1"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             TextChanged="ResetInputChanged"
                             Text="0" />

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               VerticalAlignment="Center"
                               Text="Puntos por reset" />
                    <TextBox x:Name="PointsPerResetTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,12,0,0"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             TextChanged="ResetInputChanged"
                             Text="0" />

                    <TextBlock Grid.Row="2"
                               Margin="0,12,0,0"
                               VerticalAlignment="Center"
                               Text="Puntos totales por resets" />
                    <TextBox x:Name="TotalResetPointsTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,12,0,0"
                             MinHeight="30"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="9"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Distribución de puntos disponibles">
                <StackPanel x:Name="StatsAllocationPanel"
                            Margin="12" />
            </GroupBox>

            <Button x:Name="DistributeStatsButton"
                    Grid.Row="10"
                    Grid.Column="1"
                    Width="160"
                    Margin="0,16,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="DistributeStatsButtonClick"
                    Content="Distribuir stats" />

            <TextBox x:Name="DistributionResultTextBox"
                     Grid.Row="11"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="96"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de distribución" />

            <GroupBox Grid.Row="21"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Toda la informacion derivada (dmg, dmg rate, def, def rate, speed...)" AutomationProperties.HelpText="Resultado completo de atributos derivados">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="EvaluateBuildButton"
                            Content="Evaluar atributos derivados"
                            HorizontalAlignment="Left"
                            Padding="12,4"
                            Click="EvaluateBuildButtonClick"
                            AutomationProperties.Name="Evaluar todos los atributos derivados" />
                    <TextBlock Text="Fórmula publicada"
                               Grid.Row="1"
                               Margin="0,12,0,0"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="FormulaComboBox"
                              Grid.Row="2"
                              Margin="0,6,0,12"
                              MinWidth="320"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="FormulaSelectionChanged"
                              AutomationProperties.Name="Fórmula derivada publicada" />
                    <TextBox x:Name="FormulaResultTextBox"
                             Grid.Row="3"
                             Padding="12"
                             MinHeight="160"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Resultado y trazas de fórmula" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="13"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Borrador local">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="ID del borrador" />
                    <TextBox x:Name="BuildDraftIdTextBox"
                             Grid.Column="1"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             Text="mi-build" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Width="120"
                                Padding="12,6"
                                Click="SaveBuildDraftButtonClick"
                                Content="Guardar" />
                        <Button Width="120"
                                Margin="12,0,0,0"
                                Padding="12,6"
                                Click="LoadBuildDraftButtonClick"
                                Content="Cargar" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBox x:Name="BuildDraftResultTextBox"
                     Grid.Row="14"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="72"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de borrador" />

            <GroupBox Grid.Row="15"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Build completa local">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="ID de la build" />
                    <TextBox x:Name="BuildIdTextBox"
                             Grid.Column="1"
                             MinHeight="30"
                             VerticalContentAlignment="Center"
                             Text="mi-build" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Width="160"
                                Padding="12,6"
                                Click="SaveBuildButtonClick"
                                Content="Guardar build" />
                        <Button Width="120"
                                Margin="12,0,0,0"
                                Padding="12,6"
                                Click="LoadBuildButtonClick"
                                Content="Cargar" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,16,0,0"
                               VerticalAlignment="Top"
                               Text="Builds guardadas" />
                    <ListBox x:Name="SavedBuildsListBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,16,0,0"
                             MinHeight="96"
                             AutomationProperties.Name="Builds guardadas">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{Binding Id}" />
                                    <Run Text=" · nivel " />
                                    <Run Text="{Binding Level}" />
                                    <Run Text=" · resets " />
                                    <Run Text="{Binding ResetCount}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding DatasetVersion}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Width="180"
                                Padding="12,6"
                                Click="SavedBuildLoadClick"
                                Content="Cargar seleccionada" />
                        <TextBlock x:Name="SavedBuildsStatusTextBox"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBox x:Name="BuildResultTextBox"
                     Grid.Row="16"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="72"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de build completa" />

            <GroupBox Grid.Row="17"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Elegibilidad de equipado (catálogo de ítems)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Ranura" />
                    <ComboBox x:Name="ItemSlotComboBox"
                              Grid.Column="1"
                              MinHeight="30"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ItemSlotSelectionChanged"
                              AutomationProperties.Name="Ranura de equipamiento" />

                    <TextBlock Grid.Row="1"
                               Margin="0,12,0,0"
                               VerticalAlignment="Center"
                               Text="Ítem" />
                    <ComboBox x:Name="ItemComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,12,0,0"
                              MinHeight="30"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ItemSelectionChanged"
                              AutomationProperties.Name="Ítem del catálogo" />
                </Grid>
            </GroupBox>

            <TextBox x:Name="ItemResultTextBox"
                     Grid.Row="18"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="72"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de elegibilidad de equipado" />

            <GroupBox Grid.Row="19"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Aprendizaje de skills (catálogo acotado)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Skill" />
                    <ComboBox x:Name="SkillComboBox"
                              Grid.Column="1"
                              MinHeight="30"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="SkillSelectionChanged"
                              AutomationProperties.Name="Skill del catálogo acotado" />
                </Grid>
            </GroupBox>

            <TextBox x:Name="SkillResultTextBox"
                     Grid.Row="20"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="72"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de aprendizaje de skill" />
        </Grid>
    </ScrollViewer>
</Window>
