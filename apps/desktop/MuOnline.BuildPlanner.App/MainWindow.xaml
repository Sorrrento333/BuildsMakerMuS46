<Window x:Class="MuOnline.BuildPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MU Online Build Planner"
        Width="720"
        Height="780"
        MinWidth="640"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Grid.ColumnSpan="2"
                       Text="MU Online Build Planner" />

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,8,0,24"
                       TextWrapping="Wrap"
                       Text="Presupuesto de puntos ganados — ruleset Season 4 global/inglés verificado." />

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       Text="Clase" />
            <ComboBox x:Name="ClassComboBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      MinHeight="30"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ClassSelectionChanged" />

            <TextBlock Grid.Row="3"
                       Margin="0,12,0,0"
                       VerticalAlignment="Center"
                       Text="Evolución" />
            <ComboBox x:Name="EvolutionComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,12,0,0"
                      MinHeight="30"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="EvolutionSelectionChanged" />

            <TextBlock Grid.Row="4"
                       Margin="0,12,0,0"
                       VerticalAlignment="Center"
                       Text="Nivel" />
            <TextBox x:Name="LevelTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,12,0,0"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     TextChanged="ProgressionInputChanged"
                     Text="1" />

            <CheckBox x:Name="HeroStatusCheckBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Margin="0,16,0,0"
                      Checked="ProgressionInputChanged"
                      Unchecked="ProgressionInputChanged"
                      Content="Hero Status / Marlon completado" />

            <Button Grid.Row="6"
                    Grid.Column="1"
                    Width="160"
                    Margin="0,20,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Click="CalculateButtonClick"
                    Content="Calcular puntos" />

            <TextBox x:Name="ResultTextBox"
                     Grid.Row="7"
                     Grid.ColumnSpan="2"
                     Margin="0,24,0,0"
                     Padding="12"
                     MinHeight="160"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado y traza" />

            <GroupBox Grid.Row="8"
                      Grid.ColumnSpan="2"
                      Margin="0,24,0,0"
                      Header="Distribución de puntos ganados">
                <StackPanel x:Name="StatsAllocationPanel"
                            Margin="12" />
            </GroupBox>

            <Button x:Name="DistributeStatsButton"
                    Grid.Row="9"
                    Grid.Column="1"
                    Width="160"
                    Margin="0,16,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="DistributeStatsButtonClick"
                    Content="Distribuir stats" />

            <TextBox x:Name="DistributionResultTextBox"
                     Grid.Row="10"
                     Grid.ColumnSpan="2"
                     Margin="0,16,0,0"
                     Padding="12"
                     MinHeight="96"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado de distribución" />
        </Grid>
    </ScrollViewer>
</Window>
