<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MuOnline.BuildPlanner.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/application/MuOnline.BuildPlanner.Application/MuOnline.BuildPlanner.Application.csproj" />
    <ProjectReference Include="../../../packages/data-access/MuOnline.BuildPlanner.Data/MuOnline.BuildPlanner.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../packages/rulesets/mu-s4-global-reference/v1/**/*">
      <Link>rulesets/mu-s4-global-reference/v1/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../../LICENSE.md"
             Link="LICENSE.md"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../NOTICE"
             Link="NOTICE"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../legal/runtime/Microsoft.Data.Sqlite-MIT.txt"
             Link="licenses/Microsoft.Data.Sqlite-MIT.txt"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../LICENSE.md"
             Link="licenses/SQLitePCLRaw-Apache-2.0.txt"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="IncludeResolvedRuntimeLegalFiles"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_NetCoreRuntimePack Include="@(ResolvedRuntimePack)"
                           Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_WindowsDesktopRuntimePack Include="@(ResolvedRuntimePack)"
                                  Condition="'%(FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <_AspNetCoreRuntimePack Include="@(ResolvedRuntimePack)"
                              Condition="'%(FrameworkName)' == 'Microsoft.AspNetCore.App'" />

      <ResolvedFileToPublish Include="%(_NetCoreRuntimePack.PackageDirectory)/LICENSE.TXT"
                             RelativePath="licenses/dotnet-runtime/LICENSE.txt" />
      <ResolvedFileToPublish Include="%(_NetCoreRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
                             RelativePath="licenses/dotnet-runtime/THIRD-PARTY-NOTICES.txt" />
      <ResolvedFileToPublish Include="%(_WindowsDesktopRuntimePack.PackageDirectory)/LICENSE"
                             RelativePath="licenses/windowsdesktop-runtime/LICENSE.txt" />
      <ResolvedFileToPublish Include="%(_AspNetCoreRuntimePack.PackageDirectory)/LICENSE.txt"
                             RelativePath="licenses/aspnetcore-runtime/LICENSE.txt" />
      <ResolvedFileToPublish Include="%(_AspNetCoreRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
                             RelativePath="licenses/aspnetcore-runtime/THIRD-PARTY-NOTICES.txt" />
    </ItemGroup>
  </Target>
</Project>
