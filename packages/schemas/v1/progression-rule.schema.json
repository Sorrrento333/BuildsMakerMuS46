{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/progression-rule.schema.json",
  "title": "ProgressionRuleDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "rulesetId",
    "status",
    "confidence",
    "appliesToClassIds",
    "levelPoints",
    "evidenceRefs",
    "testCaseRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "rulesetId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["DRAFT", "REVIEWED", "PUBLISHED", "DEPRECATED"] },
    "confidence": { "$ref": "#/$defs/confidence" },
    "appliesToClassIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "levelPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointsPerLevel", "firstAwardedLevel"],
      "properties": {
        "pointsPerLevel": { "type": "integer", "minimum": 1 },
        "firstAwardedLevel": { "type": "integer", "minimum": 2 }
      }
    },
    "questBonus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questId",
        "minimumLevel",
        "eligibleEvolutionIds",
        "additionalPointsPerLevel",
        "retroactiveFromLevel",
        "evidenceRefs"
      ],
      "properties": {
        "questId": { "$ref": "#/$defs/id" },
        "minimumLevel": { "type": "integer", "minimum": 1 },
        "eligibleEvolutionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "additionalPointsPerLevel": { "type": "integer", "minimum": 1 },
        "retroactiveFromLevel": { "type": "integer", "minimum": 1 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "testCaseRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PUBLISHED" } }, "required": ["status"] },
      "then": { "properties": { "testCaseRefs": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "confidence": { "enum": ["UNVERIFIED", "PARTIAL", "VERIFIED", "DISPUTED", "DEPRECATED"] }
  }
}
