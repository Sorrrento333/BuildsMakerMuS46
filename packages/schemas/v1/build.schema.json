{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/build.schema.json",
  "title": "CharacterBuild",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "ruleset", "dataset", "engineVersion", "characterClassId", "evolutionId", "level", "stats", "questIds", "resetCount"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "ruleset": { "$ref": "#/$defs/versionedRef" },
    "serverProfile": { "$ref": "#/$defs/versionedRef" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hash"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "engineVersion": { "$ref": "#/$defs/semver" },
    "characterClassId": { "$ref": "#/$defs/id" },
    "evolutionId": { "$ref": "#/$defs/id" },
    "level": { "type": "integer", "minimum": 1 },
    "stats": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
    "questIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "resetCount": { "type": "integer", "minimum": 0 },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "buffIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "experimental": { "type": "boolean", "default": false },
    "notes": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
