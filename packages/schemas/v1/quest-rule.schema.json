{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/quest-rule.schema.json",
  "title": "QuestRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "rulesetId",
    "displayName",
    "status",
    "confidence",
    "seriesId",
    "stage",
    "minimumLevel",
    "eligibleEvolutionIds",
    "evidenceRefs",
    "testCaseRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "rulesetId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "REVIEWED", "PUBLISHED", "DEPRECATED"] },
    "confidence": { "$ref": "#/$defs/confidence" },
    "seriesId": { "$ref": "#/$defs/id" },
    "stage": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["BONUS_QUEST", "CLASS_ADVANCEMENT", "SCENARIO_UNLOCK"] },
    "minimumLevel": { "type": "integer", "minimum": 1 },
    "eligibleClassIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "eligibleEvolutionIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "prerequisiteQuestIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "conflictIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "testCaseRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "confidence": {
      "enum": ["UNVERIFIED", "PARTIAL", "VERIFIED", "DISPUTED", "DEPRECATED"]
    }
  }
}