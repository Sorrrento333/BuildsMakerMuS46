{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/ruleset.schema.json",
  "title": "Ruleset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "displayName",
    "gameVersion",
    "status",
    "confidence",
    "enabledFeatureIds",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "REVIEWED", "PUBLISHED", "DEPRECATED"] },
    "confidence": { "$ref": "#/$defs/confidence" },
    "enabledFeatureIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "formulaRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionedRef" },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "conflictIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "confidence": {
      "enum": ["UNVERIFIED", "PARTIAL", "VERIFIED", "DISPUTED", "DEPRECATED"]
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}