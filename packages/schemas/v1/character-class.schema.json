{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/character-class.schema.json",
  "title": "CharacterClassDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "rulesetId", "displayName", "confidence", "stats", "evolutions", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "rulesetId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1 },
    "confidence": { "$ref": "#/$defs/confidence" },
    "stats": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseValue", "evidenceRefs"],
        "properties": {
          "baseValue": { "type": "integer", "minimum": 0 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }
      }
    },
    "evolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "stage", "evidenceRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "displayName": { "type": "string", "minLength": 1 },
          "stage": { "type": "integer", "minimum": 0 },
          "prerequisiteEvolutionId": { "$ref": "#/$defs/id" },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }
      }
    },
    "progressionRuleRefs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "conflictIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "confidence": { "enum": ["UNVERIFIED", "PARTIAL", "VERIFIED", "DISPUTED", "DEPRECATED"] }
  }
}
