{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mu46.local/v1/calculation-trace.schema.json",
  "title": "CalculationTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "rulesetId",
    "formulaRef",
    "context",
    "inputs",
    "steps",
    "rounding",
    "rawOutput",
    "visibleOutput",
    "evidenceRefs",
    "conflictIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "rulesetId": { "$ref": "#/$defs/id" },
    "formulaRef": { "$ref": "#/$defs/versionedRef" },
    "context": { "$ref": "#/$defs/context" },
    "inputs": { "$ref": "#/$defs/valueMap" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "value"],
        "properties": {
          "stepId": { "$ref": "#/$defs/id" },
          "value": { "type": "number" }
        }
      }
    },
    "rounding": { "$ref": "#/$defs/rounding" },
    "rawOutput": { "type": "number" },
    "visibleOutput": { "type": "number" },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "conflictIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterClassId", "evolutionId"],
      "properties": {
        "characterClassId": { "$ref": "#/$defs/id" },
        "evolutionId": { "$ref": "#/$defs/id" }
      }
    },
    "valueMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "number" }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stage"],
      "properties": {
        "mode": {
          "enum": ["NONE", "FLOOR", "CEILING", "TRUNCATE", "HALF_UP", "HALF_EVEN"]
        },
        "stage": { "$ref": "#/$defs/id" },
        "decimalPlaces": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
