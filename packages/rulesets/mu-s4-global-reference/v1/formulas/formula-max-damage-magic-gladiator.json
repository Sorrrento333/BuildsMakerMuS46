  "purpose": "Calculate visible base maximum damage for the Magic Gladiator family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-magic-gladiator",
    "evolutionIds": ["evolution-magic-gladiator", "evolution-duel-master"]
  },
  "inputs": [
    {
      "id": "strength",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 26,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-strength"
      }
    },
    {
      "id": "energy",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 26,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-energy"
      }
    }
  ],
  "output": {
    "id": "max-damage",
    "numericType": "INT64",
    "unit": "damage-point"
  },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "strength-term",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "strength" },
          { "kind": "LITERAL", "value": 4 }
        ]
      },
      {
        "id": "energy-term",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "energy" },
          { "kind": "LITERAL", "value": 8 }
        ]
      },
      {
        "id": "raw-max-damage",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "strength-term" },
          { "kind": "STEP", "stepId": "energy-term" }
        ]
      },
      {
        "id": "visible-max-damage",
        "operation": "APPLY_ROUNDING",
        "operands": [{ "kind": "STEP", "stepId": "raw-max-damage" }]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": {
    "mode": "TRUNCATE",
    "stage": "visible-max-damage",
    "decimalPlaces": 0
  },
  "trace": {
    "stepIds": ["strength-term", "energy-term", "raw-max-damage", "visible-max-damage"],
    "rawOutputStepId": "raw-max-damage",
    "visibleOutputStepId": "visible-max-damage"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Divide Strength by the exact literal 4 and Energy by the exact literal 8 using checked decimal arithmetic, then add both terms.",
    "Represent strength-term and energy-term exactly as base-10 decimals and add them with checked decimal arithmetic.",
    "Do not round strength-term, energy-term or raw-max-damage before visible-max-damage.",
    "Truncate raw-max-damage toward zero exactly once at visible-max-damage."
  ],
