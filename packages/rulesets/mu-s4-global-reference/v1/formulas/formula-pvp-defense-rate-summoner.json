{
  "schemaVersion": "2.1.0",
  "id": "formula-pvp-defense-rate-summoner",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base PVP defense rate for the Summoner family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-summoner",
    "evolutionIds": ["evolution-summoner", "evolution-bloody-summoner", "evolution-dimension-master"]
  },
  "inputs": [
    {
      "id": "character-level",
      "numericType": "INT32",
      "unit": "level",
      "numericBounds": {
        "minimum": 1,
        "minimumInclusive": true,
        "maximum": 2147483647,
        "maximumInclusive": true,
        "classification": "TECHNICAL"
      },
      "rangeErrorCode": "formula-level-out-of-range",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "character-level" }
    },
    {
      "id": "agility",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 21,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-agility" }
    }
  ],
  "output": { "id": "pvp-defense-rate", "numericType": "INT64", "unit": "rate-point" },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "level-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "character-level" },
          { "kind": "LITERAL", "value": 2 }
        ]
      },
      {
        "id": "agility-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "agility" },
          { "kind": "LITERAL", "value": 0.5 }
        ]
      },
      {
        "id": "raw-pvp-defense-rate",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "level-contribution" },
          { "kind": "STEP", "stepId": "agility-contribution" }
        ]
      },
      {
        "id": "visible-pvp-defense-rate",
        "operation": "APPLY_ROUNDING",
        "operands": [
          { "kind": "STEP", "stepId": "raw-pvp-defense-rate" }
        ]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": { "mode": "TRUNCATE", "stage": "visible-pvp-defense-rate", "decimalPlaces": 0 },
  "trace": {
    "stepIds": ["level-contribution", "agility-contribution", "raw-pvp-defense-rate", "visible-pvp-defense-rate"],
    "rawOutputStepId": "raw-pvp-defense-rate",
    "visibleOutputStepId": "visible-pvp-defense-rate"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Represent the exact literals 2 and 0.5 as base-10 decimals and use checked decimal arithmetic.",
    "Do not round any step before visible-pvp-defense-rate.",
    "Truncate raw-pvp-defense-rate toward zero exactly once at visible-pvp-defense-rate."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "pvp-defense-rate-summoner-base", "version": "1.0.0" },
    { "id": "pvp-defense-rate-summoner-fraction-step", "version": "1.0.0" },
    { "id": "pvp-defense-rate-summoner-integer-step", "version": "1.0.0" },
    { "id": "pvp-defense-rate-summoner-dimension-master-step", "version": "1.0.0" }
  ]
}
