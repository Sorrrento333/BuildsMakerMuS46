{
  "schemaVersion": "2.1.0",
  "id": "formula-ag-dark-wizard",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base AG for the Dark Wizard family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-dark-wizard",
    "evolutionIds": ["evolution-dark-wizard", "evolution-soul-master", "evolution-grand-master"]
  },
  "inputs": [
    {
      "id": "energy",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 30,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-energy"
      }
    },
    {
      "id": "vitality",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 15,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-vitality"
      }
    },
    {
      "id": "agility",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 18,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-agility"
      }
    },
    {
      "id": "strength",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 18,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-strength"
      }
    }
  ],
  "output": {
    "id": "ag",
    "numericType": "INT64",
    "unit": "ag-point"
  },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "energy-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "energy" },
          { "kind": "LITERAL", "value": 0.2 }
        ]
      },
      {
        "id": "vitality-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "vitality" },
          { "kind": "LITERAL", "value": 0.3 }
        ]
      },
      {
        "id": "agility-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "agility" },
          { "kind": "LITERAL", "value": 0.4 }
        ]
      },
      {
        "id": "strength-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "strength" },
          { "kind": "LITERAL", "value": 0.2 }
        ]
      },
      {
        "id": "raw-ag",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "energy-contribution" },
          { "kind": "STEP", "stepId": "vitality-contribution" },
          { "kind": "STEP", "stepId": "agility-contribution" },
          { "kind": "STEP", "stepId": "strength-contribution" }
        ]
      },
      {
        "id": "visible-ag",
        "operation": "APPLY_ROUNDING",
        "operands": [{ "kind": "STEP", "stepId": "raw-ag" }]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": {
    "mode": "TRUNCATE",
    "stage": "visible-ag",
    "decimalPlaces": 0
  },
  "trace": {
    "stepIds": [
      "energy-contribution",
      "vitality-contribution",
      "agility-contribution",
      "strength-contribution",
      "raw-ag",
      "visible-ag"
    ],
    "rawOutputStepId": "raw-ag",
    "visibleOutputStepId": "visible-ag"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Represent 0.2, 0.3, and 0.4 exactly as base-10 decimals and use checked decimal arithmetic.",
    "Do not round any stat contribution or raw-ag before visible-ag.",
    "Truncate raw-ag toward zero exactly once at visible-ag."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "ag-dark-wizard-base", "version": "1.0.0" },
    { "id": "ag-dark-wizard-energy-vitality-step", "version": "1.0.0" },
    { "id": "ag-dark-wizard-agility-strength-step", "version": "1.0.0" },
    { "id": "ag-dark-wizard-combined-step", "version": "1.0.0" }
  ]
}
