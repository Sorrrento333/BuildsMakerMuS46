  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base maximum damage for the Summoner family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-summoner",
    "evolutionIds": ["evolution-summoner", "evolution-bloody-summoner", "evolution-dimension-master"]
  },
  "inputs": [
    {
      "id": "strength",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 21,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-strength"
      }
    }
  ],
  "output": {
    "id": "max-damage",
    "numericType": "INT64",
    "unit": "damage-point"
  },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "raw-max-damage",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "strength" },
          { "kind": "LITERAL", "value": 4 }
        ]
      },
      {
        "id": "visible-max-damage",
        "operation": "APPLY_ROUNDING",
        "operands": [{ "kind": "STEP", "stepId": "raw-max-damage" }]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": {
    "mode": "TRUNCATE",
    "stage": "visible-max-damage",
    "decimalPlaces": 0
  },
  "trace": {
    "stepIds": ["raw-max-damage", "visible-max-damage"],
    "rawOutputStepId": "raw-max-damage",
    "visibleOutputStepId": "visible-max-damage"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Divide Strength by the exact literal 4 using checked decimal arithmetic.",
    "Do not round raw-max-damage before visible-max-damage.",
    "Truncate raw-max-damage toward zero exactly once at visible-max-damage."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
