{
  "schemaVersion": "2.1.0",
  "id": "formula-mana-dark-knight",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base Mana for the Dark Knight family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-dark-knight",
    "evolutionIds": [
      "evolution-dark-knight",
      "evolution-blade-knight",
      "evolution-blade-master"
    ]
  },
  "inputs": [
    {
      "id": "character-level",
      "numericType": "INT32",
      "unit": "level",
      "numericBounds": {
        "minimum": 1,
        "minimumInclusive": true,
        "maximum": 2147483647,
        "maximumInclusive": true,
        "classification": "TECHNICAL"
      },
      "rangeErrorCode": "formula-level-out-of-range",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "character-level"
      }
    },
    {
      "id": "energy",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 10,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": {
        "kind": "CONTEXT_VALUE",
        "valueId": "resolved-energy"
      }
    }
  ],
  "output": {
    "id": "mana",
    "numericType": "INT64",
    "unit": "mana-point"
  },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "base",
        "operation": "CONSTANT",
        "operands": [{ "kind": "LITERAL", "value": 10 }]
      },
      {
        "id": "level-offset",
        "operation": "SUBTRACT",
        "operands": [
          { "kind": "INPUT", "inputId": "character-level" },
          { "kind": "LITERAL", "value": 1 }
        ]
      },
      {
        "id": "level-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "STEP", "stepId": "level-offset" },
          { "kind": "LITERAL", "value": 0.5 }
        ]
      },
      {
        "id": "energy-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "energy" },
          { "kind": "LITERAL", "value": 1 }
        ]
      },
      {
        "id": "raw-mana",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "base" },
          { "kind": "STEP", "stepId": "level-contribution" },
          { "kind": "STEP", "stepId": "energy-contribution" }
        ]
      },
      {
        "id": "visible-mana",
        "operation": "APPLY_ROUNDING",
        "operands": [{ "kind": "STEP", "stepId": "raw-mana" }]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": {
    "mode": "TRUNCATE",
    "stage": "visible-mana",
    "decimalPlaces": 0
  },
  "trace": {
    "stepIds": [
      "base",
      "level-offset",
      "level-contribution",
      "energy-contribution",
      "raw-mana",
      "visible-mana"
    ],
    "rawOutputStepId": "raw-mana",
    "visibleOutputStepId": "visible-mana"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Represent 0.5 exactly as a base-10 decimal and use checked decimal arithmetic.",
    "Do not round the level contribution or raw-mana before visible-mana.",
    "Truncate raw-mana toward zero exactly once at visible-mana."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "mana-dark-knight-base", "version": "1.0.0" },
    { "id": "mana-dark-knight-level-step", "version": "1.0.0" },
    { "id": "mana-dark-knight-energy-step", "version": "1.0.0" },
    { "id": "mana-dark-knight-combined-step", "version": "1.0.0" }
  ]
}
