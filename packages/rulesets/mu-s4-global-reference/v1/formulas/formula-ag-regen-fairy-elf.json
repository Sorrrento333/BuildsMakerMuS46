{
  "schemaVersion": "2.1.0",
  "id": "formula-ag-regen-fairy-elf",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base AG regeneration for the Fairy Elf family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-fairy-elf",
    "evolutionIds": ["evolution-fairy-elf", "evolution-muse-elf", "evolution-high-elf"]
  },
  "inputs": [
    {
      "id": "agility",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 25,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-agility" }
    },
    {
      "id": "ag",
      "numericType": "DECIMAL",
      "unit": "ag-point",
      "numericBounds": {
        "minimum": 0,
        "minimumInclusive": true,
        "classification": "TECHNICAL"
      },
      "rangeErrorCode": "formula-dependency-out-of-range",
      "source": {
        "kind": "FORMULA_OUTPUT",
        "formulaId": "formula-ag-fairy-elf",
        "formulaVersion": "1.0.0",
        "outputStage": "RAW"
      }
    }
  ],
  "output": { "id": "ag-regen", "numericType": "INT64", "unit": "ag-regen-point" },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "base-ag-regen",
        "operation": "CONSTANT",
        "operands": [
          { "kind": "LITERAL", "value": 2 }
        ]
      },
      {
        "id": "ag-contribution",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "ag" },
          { "kind": "LITERAL", "value": 33.33 }
        ]
      },
      {
        "id": "raw-ag-regen",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "base-ag-regen" },
          { "kind": "STEP", "stepId": "ag-contribution" }
        ]
      },
      {
        "id": "visible-ag-regen",
        "operation": "APPLY_ROUNDING",
        "operands": [
          { "kind": "STEP", "stepId": "raw-ag-regen" }
        ]
      }
    ],
    "dependencyFormulaRefs": [
      { "id": "formula-ag-fairy-elf", "version": "1.0.0" }
    ]
  },
  "rounding": { "mode": "TRUNCATE", "stage": "visible-ag-regen", "decimalPlaces": 0 },
  "trace": {
    "stepIds": ["base-ag-regen", "ag-contribution", "raw-ag-regen", "visible-ag-regen"],
    "rawOutputStepId": "raw-ag-regen",
    "visibleOutputStepId": "visible-ag-regen"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Resolve formula-ag-fairy-elf version 1.0.0 from the same validated character state.",
    "Resolve Agility from the same validated character state as the AG pool dependency.",
    "Consume the RAW decimal ag output selected by owner decision EVD-0026.",
    "Represent the exact literals 2 and 33.33 as base-10 decimals and use checked decimal arithmetic.",
    "Do not round raw-ag-regen before visible-ag-regen.",
    "Truncate raw-ag-regen toward zero exactly once at visible-ag-regen."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "ag-regen-fairy-elf-base", "version": "1.0.0" },
    { "id": "ag-regen-fairy-elf-fraction-step", "version": "1.0.0" },
    { "id": "ag-regen-fairy-elf-integer-step", "version": "1.0.0" },
    { "id": "ag-regen-fairy-elf-high-elf-step", "version": "1.0.0" }
  ]
}
