{
  "schemaVersion": "2.1.0",
  "id": "formula-pvm-attack-rate-dark-knight",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base PVM attack rate for the Dark Knight family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-dark-knight",
    "evolutionIds": ["evolution-dark-knight", "evolution-blade-knight", "evolution-blade-master"]
  },
  "inputs": [
    {
      "id": "character-level",
      "numericType": "INT32",
      "unit": "level",
      "numericBounds": {
        "minimum": 1,
        "minimumInclusive": true,
        "maximum": 2147483647,
        "maximumInclusive": true,
        "classification": "TECHNICAL"
      },
      "rangeErrorCode": "formula-level-out-of-range",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "character-level" }
    },
    {
      "id": "agility",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 20,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-agility" }
    },
    {
      "id": "strength",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 28,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-strength" }
    }
  ],
  "output": { "id": "pvm-attack-rate", "numericType": "INT64", "unit": "rate-point" },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "level-contribution",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "character-level" },
          { "kind": "LITERAL", "value": 5 }
        ]
      },
      {
        "id": "agility-numerator",
        "operation": "MULTIPLY",
        "operands": [
          { "kind": "INPUT", "inputId": "agility" },
          { "kind": "LITERAL", "value": 3 }
        ]
      },
      {
        "id": "agility-contribution",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "STEP", "stepId": "agility-numerator" },
          { "kind": "LITERAL", "value": 2 }
        ]
      },
      {
        "id": "strength-contribution",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "strength" },
          { "kind": "LITERAL", "value": 4 }
        ]
      },
      {
        "id": "raw-pvm-attack-rate",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "level-contribution" },
          { "kind": "STEP", "stepId": "agility-contribution" },
          { "kind": "STEP", "stepId": "strength-contribution" }
        ]
      },
      {
        "id": "visible-pvm-attack-rate",
        "operation": "APPLY_ROUNDING",
        "operands": [
          { "kind": "STEP", "stepId": "raw-pvm-attack-rate" }
        ]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": { "mode": "TRUNCATE", "stage": "visible-pvm-attack-rate", "decimalPlaces": 0 },
  "trace": {
    "stepIds": ["level-contribution", "agility-numerator", "agility-contribution", "strength-contribution", "raw-pvm-attack-rate", "visible-pvm-attack-rate"],
    "rawOutputStepId": "raw-pvm-attack-rate",
    "visibleOutputStepId": "visible-pvm-attack-rate"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Represent the exact literals 5, 3, 2 and 4 as base-10 decimals and use checked decimal arithmetic.",
    "Do not round any step before visible-pvm-attack-rate.",
    "Truncate raw-pvm-attack-rate toward zero exactly once at visible-pvm-attack-rate."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "pvm-attack-rate-dark-knight-base", "version": "1.0.0" },
    { "id": "pvm-attack-rate-dark-knight-fraction-step", "version": "1.0.0" },
    { "id": "pvm-attack-rate-dark-knight-integer-step", "version": "1.0.0" },
    { "id": "pvm-attack-rate-dark-knight-blade-master-step", "version": "1.0.0" }
  ]
}
