{
  "schemaVersion": "2.1.0",
  "id": "formula-max-damage-fairy-elf",
  "version": "1.0.0",
  "rulesetId": "mu-s4-global-reference",
  "status": "PUBLISHED",
  "confidence": "VERIFIED",
  "purpose": "Calculate visible base max-damage for the Fairy Elf family before equipment, options, buffs, private profiles, or undeclared modifiers.",
  "applicability": {
    "characterClassId": "class-fairy-elf",
    "evolutionIds": ["evolution-fairy-elf", "evolution-muse-elf", "evolution-high-elf"]
  },
  "inputs": [
    {
      "id": "strength",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 22,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-strength" }
    },
    {
      "id": "agility",
      "numericType": "INT64",
      "unit": "stat-point",
      "numericBounds": {
        "minimum": 25,
        "minimumInclusive": true,
        "classification": "FACTUAL",
        "evidenceRefs": ["evd-0021"]
      },
      "rangeErrorCode": "formula-stat-below-base",
      "source": { "kind": "CONTEXT_VALUE", "valueId": "resolved-agility" }
    }
  ],
  "output": { "id": "max-damage", "numericType": "INT64", "unit": "damage-point" },
  "strategy": {
    "kind": "PROGRAM",
    "executionModel": "CHECKED_DECIMAL_V1",
    "steps": [
      {
        "id": "strength-contribution",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "strength" },
          { "kind": "LITERAL", "value": 8 }
        ]
      },
      {
        "id": "agility-contribution",
        "operation": "DIVIDE",
        "operands": [
          { "kind": "INPUT", "inputId": "agility" },
          { "kind": "LITERAL", "value": 4 }
        ]
      },
      {
        "id": "raw-max-damage",
        "operation": "ADD",
        "operands": [
          { "kind": "STEP", "stepId": "strength-contribution" },
          { "kind": "STEP", "stepId": "agility-contribution" }
        ]
      },
      {
        "id": "visible-max-damage",
        "operation": "APPLY_ROUNDING",
        "operands": [
          { "kind": "STEP", "stepId": "raw-max-damage" }
        ]
      }
    ],
    "dependencyFormulaRefs": []
  },
  "rounding": { "mode": "TRUNCATE", "stage": "visible-max-damage", "decimalPlaces": 0 },
  "trace": {
    "stepIds": ["strength-contribution", "agility-contribution", "raw-max-damage", "visible-max-damage"],
    "rawOutputStepId": "raw-max-damage",
    "visibleOutputStepId": "visible-max-damage"
  },
  "constraints": [
    "Resolve class and evolution applicability before evaluating arithmetic.",
    "Represent the exact literals 8 and 4 as base-10 decimals and use checked decimal arithmetic.",
    "Do not round any step before visible-max-damage.",
    "Truncate raw-max-damage toward zero exactly once at visible-max-damage."
  ],
  "evidenceRefs": ["evd-0021", "evd-0026"],
  "conflictIds": [],
  "testCaseRefs": [
    { "id": "max-damage-fairy-elf-base", "version": "1.0.0" },
    { "id": "max-damage-fairy-elf-fraction-step", "version": "1.0.0" },
    { "id": "max-damage-fairy-elf-integer-step", "version": "1.0.0" },
    { "id": "max-damage-fairy-elf-high-elf-step", "version": "1.0.0" }
  ]
}
