<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MuOnline.SchemaValidator</RootNamespace>
    <AssemblyName>JsonEverything.SourceBuild.ContractHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/validators/MuOnline.SchemaValidator/SchemaContractValidator.cs"
             Link="SchemaContractValidator.cs" />
    <Reference Include="Json.More">
      <HintPath>$(JsonEverythingAssemblyDirectory)/Json.More.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="JsonPointer.Net">
      <HintPath>$(JsonEverythingAssemblyDirectory)/JsonPointer.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="JsonSchema.Net">
      <HintPath>$(JsonEverythingAssemblyDirectory)/JsonSchema.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Humanizer">
      <HintPath>$(HumanizerAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
